+  map_points_pub_.publish(cloud);
+
+  visualization_msgs::Marker kf;
+  kf.header = cloud.header;
+  kf.ns = "vilo_keyframes";
+  kf.type = visualization_msgs::Marker::SPHERE_LIST;
+  kf.action = visualization_msgs::Marker::ADD;
+  kf.pose.orientation.w = 1.0;
+  kf.scale.x = kf.scale.y = kf.scale.z = 0.16;
+  kf.color.r = 1.0;
+  kf.color.g = 0.4;
+  kf.color.b = 0.0;
+  kf.color.a = 1.0;
+  kf.points.reserve(kf_poses.size());
+  for (auto& p : kf_poses) {
+    geometry_msgs::Point pt;
+    pt.x = p.x();
+    pt.y = p.y();
+    pt.z = p.z();
+    kf.points.push_back(pt);
+  }
+  kf_poses_pub_.publish(kf);
+}
+
+// Draw the sliding window as a factor graph: the keyframe chain the IMU and leg
+// preintegration factors live on, and every landmark-to-keyframe reprojection
+// factor. Two LINE_LISTs so they can be toggled and coloured separately.
+void VILOFusion::publishVILOFactorGraph() {
+  std::vector<std::pair<Eigen::Vector3d, Eigen::Vector3d>> imu_edges;
+  std::vector<std::pair<Eigen::Vector3d, Eigen::Vector3d>> leg_edges;
+  std::vector<std::pair<Eigen::Vector3d, Eigen::Vector3d>> obs_edges;
+  vilo_estimator->getFactorGraph(imu_edges, leg_edges, obs_edges);
+  if (imu_edges.empty() && obs_edges.empty()) {
+    return;
+  }
+
+  // dz offsets the whole edge set vertically. The IMU and leg factors constrain the
+  // *same* pairs of keyframe nodes, so drawn in place one hides the other; nudging
+  // them apart by a few centimetres shows both as parallel edges.
+  auto make_lines = [](const std::vector<std::pair<Eigen::Vector3d, Eigen::Vector3d>>& edges, const std::string& ns,
+                       double width, float r, float g, float b, float a, double dz = 0.0) {
+    visualization_msgs::Marker m;
+    m.header.stamp = ros::Time::now();
+    m.header.frame_id = "world";
+    m.ns = ns;
+    m.type = visualization_msgs::Marker::LINE_LIST;
+    m.action = visualization_msgs::Marker::ADD;
+    m.pose.orientation.w = 1.0;
+    m.scale.x = width;
+    m.color.r = r;
+    m.color.g = g;
+    m.color.b = b;
+    m.color.a = a;
+    m.points.reserve(2 * edges.size());
+    for (auto& e : edges) {
+      geometry_msgs::Point p0, p1;
+      p0.x = e.first.x();
+      p0.y = e.first.y();
+      p0.z = e.first.z() + dz;
+      p1.x = e.second.x();
+      p1.y = e.second.y();
+      p1.z = e.second.z() + dz;
+      m.points.push_back(p0);
+      m.points.push_back(p1);
+    }
+    return m;
+  };
+
+  // Reprojection factors are numerous (up to ~120 landmarks x 11 frames), so they
+  // are thin and translucent; the keyframe chain is drawn thick on top.
+  graph_obs_pub_.publish(make_lines(obs_edges, "vilo_reprojection_factors", 0.004, 0.35f, 0.75f, 1.0f, 0.25f));
+  graph_imu_pub_.publish(make_lines(imu_edges, "vilo_imu_factors", 0.035, 1.0f, 0.95f, 0.2f, 1.0f, 0.04));
+  graph_leg_pub_.publish(make_lines(leg_edges, "vilo_leg_factors", 0.035, 1.0f, 0.35f, 0.85f, 1.0f, -0.04));
+}
