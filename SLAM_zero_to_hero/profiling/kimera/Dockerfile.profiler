# Kimera-VIO + easy_profiler instrumentation
# Base: ubuntu:20.04 (matches kimera/Dockerfile)
FROM docker.io/ubuntu:20.04
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    apt-utils build-essential cmake git wget unzip \
    libboost-all-dev libgoogle-glog-dev libgflags-dev \
    libatlas-base-dev libsuitesparse-dev libtbb-dev \
    libopencv-dev libgtest-dev ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install easy_profiler
COPY common/install_easy_profiler.sh /tmp/install_easy_profiler.sh
RUN bash /tmp/install_easy_profiler.sh && rm /tmp/install_easy_profiler.sh

# Build GTSAM 4.2
RUN git clone https://github.com/borglab/gtsam.git -b 4.2 && \
    cd gtsam && mkdir build && cd build && \
    cmake .. -DGTSAM_BUILD_TESTS=OFF \
             -DGTSAM_BUILD_EXAMPLES_ALWAYS=OFF \
             -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && make install && ldconfig && \
    cd / && rm -rf gtsam

# Install Eigen 3.4.1 from source
RUN wget -q https://gitlab.com/libeigen/eigen/-/archive/3.4.1/eigen-3.4.1.zip && \
    unzip -q eigen-3.4.1.zip && cd eigen-3.4.1 && \
    mkdir build && cd build && cmake .. && make install && \
    cd / && rm -rf eigen-3.4.1 eigen-3.4.1.zip

# Build OpenGV
RUN git clone https://github.com/laurentkneip/opengv.git && \
    cd opengv && \
    rm -f modules/FindEigen.cmake && \
    sed -i 's/find_package(Eigen REQUIRED)/find_package(Eigen3 REQUIRED)/' CMakeLists.txt && \
    sed -i 's/\${EIGEN_INCLUDE_DIRS}/\${EIGEN3_INCLUDE_DIR}/g' CMakeLists.txt && \
    sed -i 's/\${EIGEN_INCLUDE_DIR}/\${EIGEN3_INCLUDE_DIR}/g' CMakeLists.txt && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && make install && ldconfig && \
    cd / && rm -rf opengv

# Build DBoW2
RUN git clone https://github.com/dorian3d/DBoW2.git && \
    cd DBoW2 && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && make install && ldconfig && \
    cd / && rm -rf DBoW2

# Build Kimera-RPGO
RUN git clone https://github.com/MIT-SPARK/Kimera-RPGO.git && \
    cd Kimera-RPGO && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && make install && ldconfig && \
    cd / && rm -rf Kimera-RPGO

# Clone Kimera-VIO, apply profiler patches, build with profiler enabled
RUN git clone https://github.com/MIT-SPARK/Kimera-VIO.git --recursive /Kimera-VIO

COPY kimera/profiler_patch.sh /profiler_patches/profiler_patch.sh
COPY kimera/src /profiler_patches/src
RUN chmod +x /profiler_patches/profiler_patch.sh && \
    bash /profiler_patches/profiler_patch.sh /Kimera-VIO

RUN cd /Kimera-VIO && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release \
             -DKIMERA_BUILD_TESTS=OFF \
             -DWITH_PROFILER=ON && \
    make -j$(nproc)

VOLUME /output
VOLUME /data
WORKDIR /Kimera-VIO

# Run EuRoC stereo-VIO and dump profile on exit
# Mount EuRoC dataset at /data and params at /params (optional override)
CMD ["bash", "-c", \
    "/Kimera-VIO/build/stereoVIOEuroc \
        --flagfile=/Kimera-VIO/params/EuRoC/flags/stereoVIOEuroc.flags \
        --logtostderr=1 \
        --output_path=/output \
        --left_imgs_path=/data/cam0/data \
        --right_imgs_path=/data/cam1/data \
        --imu_path=/data/imu0/data.csv \
        --gt_path=/data/state_groundtruth_estimate0/data.csv \
        --params_folder_path=/Kimera-VIO/params/EuRoC \
        2>&1 | tee /output/kimera_run.log"]
