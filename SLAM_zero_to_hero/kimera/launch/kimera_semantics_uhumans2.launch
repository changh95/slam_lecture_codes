<?xml version="1.0" encoding="ISO-8859-15"?>
<!-- Kimera-Semantics on a uHumans2 bag, with the simulator's ground-truth pose.
     Same node + parameters as upstream kimera_semantics.launch; only the topics,
     the label csv and the output paths differ. -->
<launch>
  <arg name="voxel_size"       default="0.05"/>
  <arg name="max_ray_length_m" default="10"/>
  <arg name="sensor_frame"     default="left_cam"/>
  <arg name="mesh_filename"    default="/out/kimera_semantics_mesh.ply"/>
  <!-- Label csv: segmentation colour -> one of the 21 Kimera classes.
       uHumans2 office: TESSE's "office1" csv plus the one colour it misses
       (the default); uHumans2 apartment: "archviz1" (identical to Hydra's
       uhumans2_apartment.csv). run_uhumans2.sh picks the csv from the bag name. -->
  <arg name="semantic_label_2_color_csv_filepath"
       default="/kimera/config/uhumans2_office_segmentation_mapping.csv"/>
  <!-- "semantic": colour by class; "color": RGB texture -->
  <arg name="semantic_color_mode" default="semantic"/>

  <arg name="left_cam_info_topic"         default="/tesse/left_cam/camera_info"/>
  <arg name="left_cam_segmentation_topic" default="/tesse/seg_cam/rgb/image_raw"/>
  <arg name="left_cam_depth_topic"        default="/tesse/depth_cam/mono/image_raw"/>
  <arg name="semantic_pointcloud"         default="/semantic_pointcloud"/>

  <param name="use_sim_time" value="true"/>

  <!-- depth + segmentation image -> labelled (RGB-coded) point cloud -->
  <node pkg="nodelet" type="nodelet" name="nodelet_manager" args="manager" output="screen"/>
  <node pkg="nodelet" type="nodelet" name="cloudify" output="screen"
        args="load depth_image_proc/point_cloud_xyzrgb nodelet_manager -no-bond">
    <remap from="rgb/camera_info"             to="$(arg left_cam_info_topic)"/>
    <remap from="rgb/image_rect_color"        to="$(arg left_cam_segmentation_topic)"/>
    <remap from="depth_registered/image_rect" to="$(arg left_cam_depth_topic)"/>
    <remap from="depth_registered/points"     to="$(arg semantic_pointcloud)"/>
    <param name="queue_size" value="20"/>
  </node>

  <node name="kimera_semantics_node" pkg="kimera_semantics_ros" type="kimera_semantics_node"
        output="screen" args="-alsologtostderr -colorlogtostderr" clear_params="true">
    <remap from="pointcloud" to="$(arg semantic_pointcloud)"/>
    <param name="tsdf_voxel_size"           value="$(arg voxel_size)"/>
    <param name="tsdf_voxels_per_side"      value="32"/>
    <param name="max_ray_length_m"          value="$(arg max_ray_length_m)"/>
    <param name="min_time_between_msgs_sec" value="0.2"/>
    <param name="voxel_carving_enabled"     value="true"/>
    <param name="color_mode"                value="lambert_color"/>
    <param name="use_const_weight"          value="false"/>
    <param name="use_freespace_pointcloud"  value="false"/>
    <param name="sensor_frame"              value="$(arg sensor_frame)"/>
    <param name="use_tf_transforms"         value="true"/>
    <param name="enable_icp"                value="false"/>
    <param name="verbose"                   value="false"/>
    <param name="method"                    value="fast"/>
    <param name="semantic_color_mode"       value="$(arg semantic_color_mode)"/>
    <param name="semantic_measurement_probability" value="0.8"/>
    <rosparam param="dynamic_semantic_labels">[20]</rosparam>
    <param name="slice_level"               value="1.0"/>
    <param name="semantic_label_2_color_csv_filepath" value="$(arg semantic_label_2_color_csv_filepath)"/>
    <param name="publish_pointclouds"       value="false"/>
    <param name="update_mesh_every_n_sec"   value="1.0"/>
    <param name="mesh_filename"             value="$(arg mesh_filename)"/>
  </node>
</launch>
