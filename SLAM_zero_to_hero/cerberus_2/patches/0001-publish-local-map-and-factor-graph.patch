+void VILOEstimator::getLocalMap(std::vector<Eigen::Vector3d>& points, std::vector<Eigen::Vector3d>& kf_poses) {
+  points.clear();
+  kf_poses.clear();
+  std::unique_lock<std::mutex> lock(mProcess, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    return;  // solver is mid-optimisation; skip this visualization frame
+  }
+  // Before the window is initialised, Ps/Rs and every estimated_depth are
+  // meaningless, and publishing them puts a cloud of NaNs into rviz.
+  if (solver_flag != NON_LINEAR) {
+    return;
+  }
+  for (int i = 0; i <= frame_count; i++) {
+    kf_poses.push_back(Ps[i]);
+  }
+  for (auto& it_per_id : feature_manager_->feature) {
+    if (it_per_id.solve_flag != 1 || it_per_id.estimated_depth <= 0.0) {
+      continue;
+    }
+    int imu_i = it_per_id.start_frame;
+    if (imu_i < 0 || imu_i > frame_count || it_per_id.feature_per_frame.empty()) {
+      continue;
+    }
+    // point is the normalised camera-frame ray of the first observation; scale
+    // it by the solved depth, take it to the imu/body frame with (ric, tic),
+    // then to the world frame with that frame's pose. Same chain as upstream's
+    // pubPointCloud().
+    Eigen::Vector3d pts_i = it_per_id.feature_per_frame[0].point * it_per_id.estimated_depth;
+    points.push_back(Rs[imu_i] * (ric[0] * pts_i + tic[0]) + Ps[imu_i]);
+  }
+}
+
+void VILOEstimator::getFactorGraph(std::vector<std::pair<Eigen::Vector3d, Eigen::Vector3d>>& imu_edges,
+                                   std::vector<std::pair<Eigen::Vector3d, Eigen::Vector3d>>& leg_edges,
+                                   std::vector<std::pair<Eigen::Vector3d, Eigen::Vector3d>>& obs_edges) {
+  imu_edges.clear();
+  leg_edges.clear();
+  obs_edges.clear();
+  std::unique_lock<std::mutex> lock(mProcess, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    return;  // solver is mid-optimisation; skip this visualization frame
+  }
+  if (solver_flag != NON_LINEAR) {
+    return;
+  }
+  for (int i = 0; i < frame_count; i++) {
+    // pre_integrations[j] integrates i -> j, so the factor on the pair (i, i+1)
+    // is indexed i+1. Same convention for the leg terms.
+    int j = i + 1;
+    if (pre_integrations[j] != nullptr) {
+      imu_edges.emplace_back(Ps[i], Ps[j]);
+    }
+    bool has_leg = false;
+    if (VILO_FUSION_TYPE == 1) {
+      has_leg = lo_pre_integrations[j] != nullptr;
+    } else if (VILO_FUSION_TYPE == 2) {
+      for (int l = 0; l < NUM_LEG; l++) {
+        if (tlo_pre_integration[j][l] != nullptr && tlo_all_in_contact[j][l]) {
+          has_leg = true;
+          break;
+        }
+      }
+    }
+    if (has_leg) {
+      leg_edges.emplace_back(Ps[i], Ps[j]);
+    }
+  }
+  for (auto& it_per_id : feature_manager_->feature) {
+    if (it_per_id.solve_flag != 1 || it_per_id.estimated_depth <= 0.0) {
+      continue;
+    }
+    int imu_i = it_per_id.start_frame;
+    if (imu_i < 0 || imu_i > frame_count || it_per_id.feature_per_frame.empty()) {
+      continue;
+    }
+    Eigen::Vector3d pts_i = it_per_id.feature_per_frame[0].point * it_per_id.estimated_depth;
+    Eigen::Vector3d lm = Rs[imu_i] * (ric[0] * pts_i + tic[0]) + Ps[imu_i];
+    // feature_per_frame holds one entry per *consecutive* frame from start_frame
+    // on, so the observing keyframes are exactly that index range.
+    int last = std::min(imu_i + static_cast<int>(it_per_id.feature_per_frame.size()) - 1, frame_count);
+    for (int j = imu_i; j <= last; j++) {
+      obs_edges.emplace_back(lm, Ps[j]);
+    }
+  }
+}
