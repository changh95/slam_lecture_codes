Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 12
      Color: 90; 90; 90
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/PointCloud2
      Name: map (accumulated /cloud_registered)
      Enabled: true
      Topic: /cloud_registered
      Queue Size: 200
      Decay Time: 1000
      Style: Points
      Size (Pixels): 1
      Alpha: 0.35
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: false
      Min Value: -1.5
      Max Value: 4.5
      Use Fixed Frame: true
      Use rainbow: true
      Invert Rainbow: true
      Position Transformer: XYZ
      Selectable: false
      Value: true
    - Class: rviz/Path
      Name: trajectory (/path)
      Enabled: true
      Topic: /path
      Queue Size: 10
      Line Style: Billboards
      Line Width: 0.3
      Color: 255; 40; 200
      Alpha: 1
      Buffer Length: 1
      Pose Style: None
      Value: true
    - Class: rviz/Axes
      Name: body
      Enabled: true
      Reference Frame: body
      Length: 1
      Radius: 0.1
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 20; 24
    Default Light: true
    Fixed Frame: camera_init
    Frame Rate: 5
  Name: root
  Tools:
    - Class: rviz/MoveCamera
  Value: true
  Views:
    Current:
      Class: slam_zero_to_hero/UnifiedOrbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Focal Point:
        X: 2.4
        Y: -10.6
        Z: 1.2
      Distance: 34
      Invert Z Axis: true
      Pitch: 1.35
      Yaw: 3.14
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Hide Left Dock: true
  Hide Right Dock: true
  Height: 1000
  Width: 1400
  X: 0
  Y: 0
