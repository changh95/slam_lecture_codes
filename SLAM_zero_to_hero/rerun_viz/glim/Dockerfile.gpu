# GPU-accelerated GLIM with VGICP-GPU registration.
# Base: CUDA 12.2 + Ubuntu 20.04 (for ROS Noetic compatibility).
FROM nvidia/cuda:12.6.3-devel-ubuntu20.04

ARG DEBIAN_FRONTEND=noninteractive
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

# --- ROS Noetic install ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg lsb-release && \
    curl -sSL 'https://raw.githubusercontent.com/ros/rosdistro/master/ros.key' -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros/ubuntu $(lsb_release -cs) main" > /etc/apt/sources.list.d/ros1.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-noetic-ros-base \
    ros-noetic-cv-bridge ros-noetic-tf2-ros ros-noetic-rosbag \
    ros-noetic-pcl-ros ros-noetic-image-transport && \
    rm -rf /var/lib/apt/lists/*

# --- Dev deps for GLIM stack ---
# libgl1-mesa-dev + mesa-common-dev are needed by gtsam_points_cuda's
# gl_buffer_map.cu which includes <cuda_gl_interop.h>
# NOTE: we deliberately skip libeigen3-dev (Ubuntu 20.04 ships 3.3.7 which is
# too old for gtsam_points CUDA kernels that call Eigen .inverse() from
# __device__ code). We build Eigen 3.4.0 from source below.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git wget ca-certificates ninja-build \
    python3 python3-pip \
    libpcl-dev libopencv-dev \
    libboost-all-dev libgoogle-glog-dev libgflags-dev \
    libatlas-base-dev libsuitesparse-dev libtbb-dev \
    libspdlog-dev libfmt-dev \
    libgl1-mesa-dev mesa-common-dev \
    libglfw3-dev libglm-dev libpng-dev \
    libgtest-dev nlohmann-json3-dev && \
    rm -rf /var/lib/apt/lists/*

# --- Eigen 3.4.0 (header-only, ~1 min to install) ---
RUN git clone https://gitlab.com/libeigen/eigen.git -b 3.4.0 --depth 1 && \
    cd eigen && mkdir build && cd build && \
    cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local && \
    make install && \
    cd / && rm -rf eigen

# Newer CMake (gtsam_points >= 3.22)
RUN wget -qO- https://github.com/Kitware/CMake/releases/download/v3.28.3/cmake-3.28.3-linux-$(uname -m).tar.gz | \
    tar xz -C /usr/local --strip-components=1

# rerun-sdk 0.21 (last version compatible with Python 3.8)
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install --no-cache-dir numpy "rerun-sdk==0.21.0"

# --- GTSAM 4.2.0 ---
RUN git clone https://github.com/borglab/gtsam.git -b 4.2.0 && \
    cd gtsam && mkdir build && cd build && \
    cmake .. -DGTSAM_BUILD_TESTS=OFF \
             -DGTSAM_BUILD_EXAMPLES_ALWAYS=OFF \
             -DGTSAM_USE_SYSTEM_EIGEN=ON \
             -DCMAKE_BUILD_TYPE=Release \
             -DCMAKE_CXX_FLAGS="-Wno-error=maybe-uninitialized -Wno-error=array-bounds" && \
    make -j$(nproc) && make install && ldconfig && \
    cd / && rm -rf gtsam

# --- iridescence ---
RUN git clone https://github.com/koide3/iridescence.git --recursive && \
    cd iridescence && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && make install && ldconfig && \
    cd / && rm -rf iridescence

# --- gtsam_points v1.1.0 with CUDA (newer than v1.0.0 to fix thrust namespace
#     ambiguity that breaks compilation against CUDA 12.5+) ---
RUN git clone https://github.com/koide3/gtsam_points.git -b v1.1.0 --recursive && \
    cd gtsam_points && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release \
             -DBUILD_WITH_CUDA=ON \
             -DCMAKE_CUDA_ARCHITECTURES="75;80;86;87;89;90" \
             -DCMAKE_CXX_FLAGS="-Wno-error=maybe-uninitialized -Wno-error=array-bounds" && \
    make -j$(nproc) && make install && ldconfig && \
    cd / && rm -rf gtsam_points

# --- GLIM v1.1.0 with CUDA (matches gtsam_points v1.1.0) ---
RUN git clone https://github.com/koide3/glim.git -b v1.1.0 --recursive && \
    cd glim && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DBUILD_WITH_CUDA=ON && \
    make -j$(nproc) && make install && ldconfig

# --- glim_ros1 v1.1.0 (provides glim_rosbag executable) ---
RUN git clone https://github.com/koide3/glim_ros1.git -b v1.1.0 && \
    cd glim_ros1 && mkdir build && cd build && \
    . /opt/ros/noetic/setup.sh && \
    cmake .. -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && make install && ldconfig

COPY ros_rerun_bridge.py /app/ros_rerun_bridge.py
COPY entrypoint.gpu.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENV PYTHONUNBUFFERED=1
WORKDIR /data
EXPOSE 9090 9877
ENTRYPOINT ["/app/entrypoint.sh"]
