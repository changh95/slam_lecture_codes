+  sensor_msgs::PointCloud cloud;
+  cloud.header.stamp = ros::Time::now();
+  cloud.header.frame_id = "world";
+  cloud.points.reserve(points.size());
+  for (auto& p : points) {
+    geometry_msgs::Point32 pt;
+    pt.x = p.x();
+    pt.y = p.y();
+    pt.z = p.z();
+    cloud.points.push_back(pt);
