{
  /*** SE3 poses are TUM format [x,y,z,qx,qy,qz,qw].
       T_lidar_imu maps imu-frame points into the lidar frame. ***/
  "sensors": {
    // Unchanged (OXTS INS, 100 Hz, no gaps, no stamp rewinds).
    "imu_acc_noise": 0.05,
    "imu_gyro_noise": 0.02,
    "imu_int_noise": 0.001,
    "imu_bias_noise": 0.001,
    // DEVIATION: config_kitti_gpu forces true. Here /surf/hesai_lidar carries a
    // real FLOAT64 per-point "timestamp" holding an ABSOLUTE epoch time (measured
    // 1713316183.796970..., 0.0999 s span/scan, header stamp within 32 us of the
    // first point). glim v1.0.0's TimeKeeper needs no key: times.front() >= 1.0
    // selects its "absolute" branch and, because |header - times.front()| < 1 s,
    // it adopts the first point stamp as the frame stamp and rebases the rest to
    // [0,0.1). Deskewing is therefore genuine -- and at 33 m/s one sweep smears
    // 3.3 m. KITTI had to force true because its ring-major .bin has no real
    // per-point time at all.
    // Do NOT copy the dataset config's autoconf_perpoint_times /
    // perpoint_relative_time / perpoint_time_scale: v1.0.0 does not read them.
    "global_shutter_lidar": false,
    // DEVIATION from BOTH config_kitti_gpu and the dataset's own config (both
    // identity): the LiDAR is measurably tilted 1.544 deg from the IMU.
    //   ground plane fit, first stationary scan, 4-30 m, 4295 inliers ->
    //     normal (0.01747, 0.02051, 0.99964) in hesai_link
    //   150 IMU samples over the same interval -> gravity (-0.00001, 0.00016,
    //     1.00000) in imu_link, i.e. the IMU is level to 0.009 deg
    // With identity, odometry integrates forward motion ~2 deg off horizontal:
    // raw z falls 20 m over the first 604 m (slope fit -2.13 deg) while GNSS
    // altitude moves 2.3 m. Below is the minimal rotation taking imu +z onto the
    // LiDAR ground normal (axis (-0.76127, 0.64844, 0), angle 1.5438 deg); yaw is
    // unobservable from gravity so it is left at 0, and the lever arm was not
    // measured so translation stays 0 (<1 m, far below the achieved ATE).
    // Measured on the 400 s slice: ATE 3D rmse 2.419 -> 2.176 m.
    "T_lidar_imu": [0.0, 0.0, 0.0, -0.0102559, 0.0087358, 0.0, 0.9999092],
    // Camera block: no image topic in this bag, so inert. Kept byte-identical to
    // config_kitti_gpu rather than invented.
    "global_shutter_camera": true,
    "image_size": [752, 480],
    "T_lidar_camera": [-0.00320, -0.05292, 0.00108, 0.00837, 0.72559, -0.00328, 0.68807],
    "intrinsics": [815.498895336274, 817.4904316140473, 830.3149255906893, 639.4531613962971],
    "distortion_model": "plumb_bob",
    "distortion_coeffs": [-0.02295507941388206, 0.0681131726659881, -0.0005798510962983399, 0.00128686963241809, -0.03279627881588615]
  }
}
