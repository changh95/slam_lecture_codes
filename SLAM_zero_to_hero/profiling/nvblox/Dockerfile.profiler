ARG BASE_IMAGE=nvidia/cuda:12.6.3-devel-ubuntu22.04
FROM ${BASE_IMAGE}
ARG DEBIAN_FRONTEND=noninteractive

ENV NVIDIA_VISIBLE_DEVICES=${NVIDIA_VISIBLE_DEVICES:-all}
ENV NVIDIA_DRIVER_CAPABILITIES=${NVIDIA_DRIVER_CAPABILITIES:+$NVIDIA_DRIVER_CAPABILITIES,}compute,utility,graphics

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    build-essential cmake git git-lfs wget curl ca-certificates \
    libeigen3-dev libgoogle-glog-dev libgflags-dev \
    libsqlite3-dev libgtest-dev libepoxy-dev \
    python3 python3-dev && \
    rm -rf /var/lib/apt/lists/*

# Build nvblox from source (Apache 2.0, C++ + CUDA). fuse_replica /
# fuse_3dmatch each embed nvblox's built-in nvblox::timing::Timer, which
# tracks per-call count/total/mean/stddev/min/max for every stage of the
# fuser, TSDF, ESDF, mesh, color, and GPU hash pipelines. Dumping that via
# --timing_output_path gives a full component-level breakdown with no
# source instrumentation — which is why this Dockerfile no longer bothers
# with the (broken on aarch64) nvblox Python bindings.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libbenchmark-dev libstdgpu-dev libpcl-dev && \
    rm -rf /var/lib/apt/lists/* || true
RUN git clone https://github.com/nvidia-isaac/nvblox.git /nvblox_src --recursive --depth 1 && \
    cd /nvblox_src && mkdir build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES="70;75;80;86;89;90" \
        -DBUILD_TESTING=OFF \
        -DBUILD_PYTORCH_WRAPPER=OFF && \
    make -j$(nproc) && make install && ldconfig

# Copy the timing-file parser and the one-shot wrapper. parse_nvblox_timing.py
# converts nvblox::timing::Timer output into the shared analyze_profiler CSV
# schema; run_profile.sh chains fuse_replica -> parser in a single command.
COPY nvblox/parse_nvblox_timing.py /app/parse_nvblox_timing.py
COPY nvblox/nvblox_timing_to_json.py /app/nvblox_timing_to_json.py
COPY nvblox/run_profile.sh /app/run_profile.sh
RUN chmod +x /app/run_profile.sh

VOLUME /data
VOLUME /output
WORKDIR /app

CMD ["/app/run_profile.sh"]
